{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/contexto-inicial.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(tenancy-guardian|privacy-guardian|conformidade-reviewer|infra-guardian|test-engineer|revisor-geral|llm-integrator|pedagogia-reviewer|frontend-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/processo/hook-revisoes.ts\" registrar"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/processo/hook-revisoes.ts\" portao"
          }
        ]
      }
    ]
  }
}
