{
  "autoCompactWindow": 400000,
  "subagentPromptCacheTtl": "5m",
  "env": {
    "npm_config_yes": "false"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/contexto-inicial.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/aviso-de-sessao.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(tenancy-guardian|privacy-guardian|conformidade-reviewer|infra-guardian|test-engineer|revisor-geral|llm-integrator|pedagogia-reviewer|frontend-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/processo/hook-revisoes.ts\" registrar"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/processo/hook-revisoes.ts\" portao || { echo 'hook de revisões não carregou: nenhum Bash roda até consertar tools/processo/. Avise o Joaquim.' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
