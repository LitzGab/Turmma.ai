# Ambiente local e esteira. Só valores sintéticos: nunca coloque aqui credencial real.
# Este arquivo basta para subir tudo (`docker compose up`); a esteira usa só ele.

AMBIENTE=local

# Threads do libuv em api, realtime, despachante e worker. A resolução de nome (dns.lookup) roda nelas: com
# 4, o padrão do Node, Redis, storage e observabilidade fora do ar ocupavam todas com consultas de nome que
# não resolve, e a conexão nova ao Postgres esperava 15 s na fila (docs/infra.md, "Threads e DNS").
UV_THREADPOOL_SIZE=16

# Postgres (pgvector). O máximo de conexões cabe a soma dos pools de todas as instâncias, com folga.
POSTGRES_USUARIO=educa
POSTGRES_SENHA=educa_local_sintetica
POSTGRES_BANCO=educa
POSTGRES_PORTA_HOST=55432
POSTGRES_CONEXOES_MAXIMAS=250

# Redis de fila (BullMQ): noeviction e AOF
REDIS_FILA_MEMORIA_MAXIMA=256mb
REDIS_FILA_PORTA_HOST=56379

# Redis de cache (rate limit): allkeys-lru, sem persistência
REDIS_CACHE_MEMORIA_MAXIMA=128mb
REDIS_CACHE_PORTA_HOST=56380

# Storage S3 (SeaweedFS)
STORAGE_CHAVE_ACESSO=educalocal
STORAGE_CHAVE_SECRETA=educa_local_sintetica_s3
STORAGE_BUCKET=educa-local
# Região da assinatura S3. O SeaweedFS local aceita qualquer uma; em nuvem é a do bucket (D28).
STORAGE_REGIAO=us-east-1
STORAGE_PORTA_HOST=58333

# Borda (Caddy): a entrada da API e do realtime, balanceando as duas instâncias de cada
BORDA_PORTA_HOST=53000

# API (duas instâncias). A soma dos pools cabe no max_connections do Postgres.
API_1_PORTA_HOST=53001
API_2_PORTA_HOST=53002
BANCO_POOL_MAXIMO=10
BANCO_TIMEOUT_CONEXAO_MS=2000
BANCO_TIMEOUT_CONSULTA_MS=2000
# Serviço migrar: prazo de cada instrução da migration, maior que o da API (criar índice passa de 2 s).
MIGRAR_TIMEOUT_CONSULTA_MS=60000
# Rotas que só existem para teste e carga (POST /v1/sistema/jobs-sinteticos). A API não sobe com
# AMBIENTE=producao e ROTAS_SINTETICAS=true.
ROTAS_SINTETICAS=true
# O que GET /v1/sistema/estado mostra como versão: `local` na máquina, o commit no staging.
VERSAO=local
# Avisos públicos do sistema que a casca mostra (GET /v1/sistema/avisos), em JSON: `[]` quando não há
# nenhum, ou [{"id":"manutencao-sabado","texto":"…","publicadoEm":"2026-09-13"}]. Nunca dado de escola.
AVISOS_SISTEMA=[]

# Rate limit da API, por minuto, somado entre as instâncias no Redis de cache: por usuário e por
# escola na rota autenticada; por IP só na rota anônima, com teto para uma escola inteira atrás de um
# NAT. Com o Redis de cache fora, cada instância limita em memória com limite ÷ LIMITE_INSTANCIAS_API.
# O X-Forwarded-For só vale vindo de LIMITE_PROXIES_CONFIAVEIS (nome ou IP, separados por vírgula).
LIMITE_REQ_USUARIO_MIN=120
LIMITE_REQ_ESCOLA_MIN=30000
LIMITE_REQ_IP_ANONIMO_MIN=3000
LIMITE_INSTANCIAS_API=2
LIMITE_PROXIES_CONFIAVEIS=borda

# Identidade. Toda requisição autenticada, e também o handshake do realtime, são conferidos contra a sessão
# gravada no Postgres; o token de uma sessão local sai de `npm run -s ops:sessao-sintetica` (só com
# AMBIENTE=local). Não há emissor configurável: só o emissor `educa` vale, em qualquer ambiente.
# A chave abaixo é pública e sintética: fora do ambiente local, a chave vem de segredo do ambiente.
IDENTIDADE_CHAVE_ASSINATURA=educa_local_sintetica_assinatura_f0

# Login da equipe por e-mail e senha. Hash argon2id com um fio, nunca abaixo do mínimo da OWASP (19456 KiB e 2
# iterações): a API não sobe abaixo dele, e a calibração pela CPU de referência só sobe (tarefa 16.0). As chaves
# são de HMAC, cada uma a sua: a do contador de tentativas (o Redis de fila nunca vê o e-mail) e a do cookie de
# dispositivo, com a versão que vai no próprio cookie. Trocar a versão (e criar LOGIN_CHAVE_DISPOSITIVO_V2)
# invalida todos os cookies de dispositivo. Valores públicos e sintéticos, só locais.
LOGIN_ARGON2_MEMORIA_KIB=19456
LOGIN_ARGON2_ITERACOES=2
LOGIN_CHAVE_CONTADOR=educa_local_sintetica_contador_de_login
LOGIN_CHAVE_DISPOSITIVO_VERSAO=1
LOGIN_CHAVE_DISPOSITIVO_V1=educa_local_sintetica_dispositivo_v1_chave

# Operador Educa.ia: quem da equipe roda `npm run -s ops:escola` (identificador curto, minúsculas, dígitos e
# hífen, como `joaquim`). Obrigatório em qualquer ambiente e gravado como autor na auditoria; fica fora
# deste arquivo de propósito, para ninguém criar escola em nome de um autor genérico:
#   OPERADOR=joaquim npm run -s ops:escola -- rede criar --nome "Rede Sintética" --tipo independente

# Realtime (duas instâncias), com o stream do adaptador no Redis de fila. O handshake lê a sessão no
# Postgres, com a mesma consulta da API, e por isso cada instância tem pool próprio: uma conexão por
# conexão nova de cliente, nunca por mensagem. A soma dos pools entra no POSTGRES_CONEXOES_MAXIMAS.
REALTIME_1_PORTA_HOST=53101
REALTIME_2_PORTA_HOST=53102
REALTIME_STREAM_TAMANHO_MAXIMO=10000
REALTIME_BANCO_POOL_MAXIMO=5

# Troca de instância: no SIGTERM, /prontidao vai a 503 e a instância segue atendendo até a borda
# perceber (sonda a cada 2 s, duas falhas: até 4 s); depois fecha e sai, com prazo total para
# requisição em andamento.
DRENAGEM_ESPERA_BORDA_MS=5000
DRENAGEM_PRAZO_MS=10000

# Fila: dois despachantes e, para cada prioridade, workers com pool próprio no Postgres. O
# statement_timeout é o mesmo BANCO_TIMEOUT_CONSULTA_MS da API, e a soma de todos os pools cabe no
# POSTGRES_CONEXOES_MAXIMAS.
DESPACHANTE_BANCO_POOL_MAXIMO=3
# Vagas por escola: quantos jobs de uma mesma escola executam ao mesmo tempo em cada fila. É o padrão
# de toda escola sem vagas próprias em configuracao_operacional_escola. As vagas somadas de dez escolas
# cabem nos pools das duas réplicas de cada worker.
VAGAS_ESCOLA_INTERATIVA=5
VAGAS_ESCOLA_NORMAL=5
VAGAS_ESCOLA_LOTE=2
# Controle negativo do cenário "justiça entre escolas": com true, despachante e worker deixam de limitar os jobs
# simultâneos de cada escola, e `npm run carga:controle-negativo` espera o cenário reprovar. Sempre false aqui;
# despachante e worker não sobem com AMBIENTE=producao e a flag em true.
VAGAS_POR_ESCOLA_DESLIGADAS=false
# Horário letivo padrão de toda escola sem horário próprio em configuracao_operacional_escola: nele, o
# lote não urgente fica segurado e sai quando o horário acaba. Fuso IANA, dias ISO (1 é segunda, 7 é
# domingo), início incluso e fim exclusivo (às 18:00 em ponto já sai). Não conhece feriado (F8).
JANELA_LETIVA_FUSO=America/Sao_Paulo
JANELA_LETIVA_DIAS=1,2,3,4,5
JANELA_LETIVA_INICIO=07:00
JANELA_LETIVA_FIM=18:00
# Pools por réplica: o worker-interativo atende interativa e normal, o worker-lote atende lote, e lote
# nenhum ocupa a vez de um interativo. O pool do banco de cada worker é a soma dos pools das filas dele:
# cada job usa uma conexão por vez.
WORKER_POOL_INTERATIVA=50
WORKER_POOL_NORMAL=30
WORKER_POOL_LOTE=10
WORKER_INTERATIVO_BANCO_POOL_MAXIMO=80
WORKER_LOTE_BANCO_POOL_MAXIMO=10
# Threads do sandbox de CPU por réplica (o job sintético queima CPU nelas, fora do event loop). No cenário de
# carga, infra/compose.carga.yml fixa `cpus:` de cada worker e o número de threads coerente com ele.
WORKER_INTERATIVO_THREADS_MAXIMO=2
WORKER_LOTE_THREADS_MAXIMO=1

# Observabilidade local (grafana/otel-lgtm): API, realtime, despachante e worker exportam métrica OTLP
# para ela a cada TELEMETRIA_INTERVALO_MS, e o despachante mede as filas por escola no mesmo ritmo. O
# Grafana abre com o painel provisionado; o Prometheus responde à consulta dos testes. Só local.
TELEMETRIA_INTERVALO_MS=5000
GRAFANA_PORTA_HOST=53300
PROMETHEUS_PORTA_HOST=59090

# Web
WEB_PORTA_HOST=58080
