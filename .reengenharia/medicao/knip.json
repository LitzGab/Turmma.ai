{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/guardas/__fixtures__/**", "tools/ci/fixtures/**"],
  "ignoreWorkspaces": [],
  "workspaces": {
    ".": {
      "entry": [
        "tools/processo/*.ts",
        "tools/vitrine/*.ts",
        "tools/ci/*.ts",
        "tools/guardas/*.{ts,mjs}",
        "tools/demonstracao/*.ts",
        "infra/scripts/*.ts",
        "infra/k6/*.js",
        "infra/test/**/*.ts",
        "e2e/**/*.ts"
      ],
      "project": ["tools/**/*.{ts,mjs}", "infra/**/*.{ts,js}", "e2e/**/*.ts"]
    },
    "apps/api": { "entry": ["src/main.ts", "src/ops/*.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/worker": { "entry": ["src/main.ts", "src/**/*.sandbox.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/realtime": { "entry": ["src/main.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/despachante": { "entry": ["src/main.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/web": { "entry": ["src/main.tsx"], "project": ["src/**/*.{ts,tsx}", "*.ts"] },
    "packages/nucleo": { "entry": ["src/index.ts", "src/db/migrar.ts"], "project": ["src/**/*.ts"] },
    "packages/shared": { "entry": ["src/index.ts"], "project": ["src/**/*.ts"] }
  }
}
