# Sobreposição usada só pelo cenário de carga (`npm run carga`), que sobe o projeto compose `educa-carga`.
# Portas próprias: o cenário nunca disputa porta, fila nem volume com o ambiente de desenvolvimento (`educa`)
# nem com o de teste (`educa-teste`), e derruba o seu no fim.
POSTGRES_PORTA_HOST=55462
REDIS_FILA_PORTA_HOST=56409
REDIS_CACHE_PORTA_HOST=56410
STORAGE_PORTA_HOST=58363
BORDA_PORTA_HOST=53030
API_1_PORTA_HOST=53031
API_2_PORTA_HOST=53032
REALTIME_1_PORTA_HOST=53131
REALTIME_2_PORTA_HOST=53132
WEB_PORTA_HOST=58110
GRAFANA_PORTA_HOST=53330
PROMETHEUS_PORTA_HOST=59120
OIDC_FALSO_PORTA_HOST=58072

# Cenário "login às 7h30" (tarefa 16.0): o hash de senha calibrado na CPU de referência (as APIs com `cpus: 1` de
# infra/compose.carga.yml), e as threads do libuv fixas, para o resultado não depender do padrão do Node. Os valores e a
# medição estão na Tech Spec da identidade, seção 5, "Hash". O `.env.example` fica no mínimo da OWASP, para o
# desenvolvimento e a esteira não pagarem o hash de produção em cada teste.
UV_THREADPOOL_SIZE=16
LOGIN_ARGON2_MEMORIA_KIB=19456
LOGIN_ARGON2_ITERACOES=12
LOGIN_HASH_CONCORRENCIA=2
