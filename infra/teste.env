# Sobreposição usada só por testes e pela esteira, que sobem o projeto compose `educa-teste`.
# Portas próprias para que `npm run test` e os `ci:*` nunca parem, pausem ou apaguem o volume
# do ambiente de desenvolvimento (`docker compose up`, projeto `educa`).
POSTGRES_PORTA_HOST=25442
REDIS_FILA_PORTA_HOST=26389
REDIS_CACHE_PORTA_HOST=26390
STORAGE_PORTA_HOST=28343
BORDA_PORTA_HOST=23010
API_1_PORTA_HOST=23011
API_2_PORTA_HOST=23012
REALTIME_1_PORTA_HOST=23111
REALTIME_2_PORTA_HOST=23112
WEB_PORTA_HOST=28090
GRAFANA_PORTA_HOST=23310
PROMETHEUS_PORTA_HOST=29100
OIDC_FALSO_PORTA_HOST=28071
# O retorno do login pela conta da escola precisa apontar para a web deste ambiente (WEB_PORTA_HOST acima): é o
# endereço para onde o provedor devolve o navegador, e de lá o proxy da web leva a chamada à API (13.0, 19.0).
LOGIN_EXTERNO_RETORNO_URL=http://127.0.0.1:28090/v1/sessao/externa/retorno
